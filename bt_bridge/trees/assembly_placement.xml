<!--
  Assembly-placement sequence: mirrors _step_arm()'s P-handling 1:1 (see
  docs/behavior-tree-migration.md) -- same behavior, expressed as a tree instead of nested `if`s.
  Every leaf's callback_name is registered from Python via bt_bridge.register_callback(); see
  scripts/mefron_lib/behavior_tree.py for what each one actually does.

  Only two steps needed migrating in: the "is anything actually held" gate, and the initial
  lift-waypoint snap. The subsequent "descend to the real final pose" step is NOT represented here
  -- it was, and remains, handled automatically by _step_arm()'s own per-frame plan/apply loop once
  the lift plan finishes (deliberately untouched by this migration). WaitForSequenceIdle's SUCCESS
  means "both the lift flight and that auto-triggered descend flight have finished."

  Ticked once per frame, gated behind the existing has_pending_assembly_target_request()/
  has_pending_placement_request() peek on the Python side (a P keypress) -- this file only
  encodes what happens once that gate is open, not the gate itself.
-->
<root BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence name="AssemblyPlacement">
      <PyCondition name="IsHoldingSomething" callback_name="is_holding_something"/>
      <PyAction name="SnapToLiftWaypoint" callback_name="snap_to_lift_waypoint"/>
      <PyAction name="WaitForSequenceIdle" callback_name="wait_for_sequence_idle"/>
    </Sequence>
  </BehaviorTree>
</root>
