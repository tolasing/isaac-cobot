# Adds cuRobo (pinned commit) on top of isaac-cobot-base.
# build-essential/cmake/git are already present in isaac-cobot-base.
#
# Built and smoke-tested (torch + curobo import, CUDA available, tensors on
# GPU) against a live RTX PRO 4000 Blackwell. TORCH_CUDA_ARCH_LIST is tuned
# to that GPU -- adjust if deploying to different hardware.

ARG DOCKER_NAME_SUFFIX=""
FROM isaac-cobot-base${DOCKER_NAME_SUFFIX} AS curobo

USER root

# Detect Ubuntu version and install CUDA 12.8 via NVIDIA's network repo
# (cuda-keyring). cuRobo compiles CUDA kernels at install time
# (--no-build-isolation below), which needs nvcc present in the image.
# ninja-build is for a separate, later need: if a prebuilt cuRobo kernel
# (e.g. kinematics_fused_cu) has a torch ABI mismatch at *runtime*, cuRobo
# falls back to JIT-compiling it via torch's cpp_extension.load(), which
# requires ninja on PATH -- confirmed missing and required live (see
# CLAUDE.md). Not `pip install ninja`: pip itself is broken in this Isaac
# Sim install (`ModuleNotFoundError: No module named
# 'pip._vendor.packaging._structures'`).
RUN set -euo pipefail && \
    . /etc/os-release && \
    case "$ID" in \
      ubuntu) \
        case "$VERSION_ID" in \
          "20.04") cuda_repo="ubuntu2004";; \
          "22.04") cuda_repo="ubuntu2204";; \
          "24.04") cuda_repo="ubuntu2404";; \
          *) echo "Unsupported Ubuntu $VERSION_ID"; exit 1;; \
        esac ;; \
      *) echo "Unsupported base OS: $ID"; exit 1 ;; \
    esac && \
    apt-get update && apt-get install -y --no-install-recommends wget gnupg ca-certificates && \
    wget -q https://developer.download.nvidia.com/compute/cuda/repos/${cuda_repo}/x86_64/cuda-keyring_1.1-1_all.deb && \
    dpkg -i cuda-keyring_1.1-1_all.deb && \
    rm -f cuda-keyring_1.1-1_all.deb && \
    wget -q https://developer.download.nvidia.com/compute/cuda/repos/${cuda_repo}/x86_64/cuda-${cuda_repo}.pin && \
    mv cuda-${cuda_repo}.pin /etc/apt/preferences.d/cuda-repository-pin-600 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        cuda-toolkit-12-8 \
        libcudnn9-cuda-12 \
        libcusparselt0 \
        libnccl2 \
        libnccl-dev \
        libnvjitlink-12-8 \
        ninja-build && \
    apt-get -y autoremove && apt-get clean && rm -rf /var/lib/apt/lists/*

ENV CUDA_HOME=/usr/local/cuda-12.8
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
# 12.0 targets Blackwell (verified against the actual dev workstation GPU:
# an RTX PRO 4000 Blackwell, sm_120). +PTX keeps other architectures
# working via JIT. Adjust if deploying to different hardware.
ENV TORCH_CUDA_ARCH_LIST=12.0+PTX

# Isaac Sim ships its own torch under omni.isaac.ml_archive/pip_prebundle/,
# which python.sh's sys.path resolves BEFORE site-packages. Left in place,
# `import torch` picks up that bundled copy instead of the one installed
# below, and crashes on a vendored-packaging submodule mismatch between the
# two (found by actually running this image against a live GPU).
RUN rm -rf ${ISAACSIM_ROOT_PATH}/exts/omni.isaac.ml_archive/pip_prebundle/torch*

# Install a CUDA-12.8-matched torch build. cuRobo needs torch present
# before its own install step below.
RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
    ${ISAACSIM_ROOT_PATH}/python.sh -m pip install torch --index-url https://download.pytorch.org/whl/cu128

# Install cuRobo from source, pinned to the commit recorded in .env.curobo.
ARG CUROBO_COMMIT_ARG
RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
    ${ISAACSIM_ROOT_PATH}/python.sh -m pip install --no-build-isolation \
    "nvidia-curobo @ git+https://github.com/NVlabs/curobo.git@${CUROBO_COMMIT_ARG}"

# BehaviorTree.CPP (+ its Groot2Publisher) and pybind11, for bt_bridge/'s pybind11 bridge -- see
# docs/behavior-tree-migration.md. Installed here (image build time), never live, same rule this
# repo already enforces for cuRobo's CUDA kernels/ninja. bt_bridge/'s own compiled extension is
# NOT built here: it's part of the live repo (bind-mounted, not baked into the image -- see this
# file's own header comment), so it's built by scripts/build_bt_bridge.sh after entering the
# container instead, against the BT.CPP/pybind11 install this step bakes in.
#
# pybind11-dev via apt, not pip: pip itself works fine at build time (see the torch/curobo
# installs above), but pybind11 is header-only and apt's package needs no live pip call anyway --
# simplest to keep everything BT-related on the same "apt, not pip" footing as ninja-build.
RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    libzmq3-dev \
    libboost-dev \
    libsqlite3-dev \
    pybind11-dev && \
    apt-get -y autoremove && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG BT_CPP_COMMIT_ARG
RUN git clone --branch ${BT_CPP_COMMIT_ARG} --depth 1 \
    https://github.com/BehaviorTree/BehaviorTree.CPP.git /tmp/behaviortree_cpp && \
    cmake -S /tmp/behaviortree_cpp -B /tmp/behaviortree_cpp/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBTCPP_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF \
    -DBTCPP_BUILD_TOOLS=OFF \
    -DBTCPP_GROOT_INTERFACE=ON && \
    cmake --build /tmp/behaviortree_cpp/build --parallel $(nproc) && \
    cmake --install /tmp/behaviortree_cpp/build && \
    ldconfig && \
    rm -rf /tmp/behaviortree_cpp

# Groot2 (desktop GUI to edit/monitor a BehaviorTree.CPP tree -- see
# docs/behavior-tree-migration.md), installed in-container since this devcontainer's X11
# forwarding is confirmed working (docs/docker-and-devcontainer.md) -- run via `groot2` once
# inside. AppImage, extracted at build time rather than run directly: a plain AppImage needs FUSE
# to mount itself, which isn't reliably available inside a container (no /dev/fuse by default);
# --appimage-extract unpacks it once here instead, so no FUSE dependency at runtime.
ARG GROOT2_VERSION_ARG=1.9.0
RUN apt-get update && apt-get install -y --no-install-recommends libfuse2 libnss3 libxcomposite1 \
    libxdamage1 libxrandr2 libxkbcommon0 libxi6 libgl1 && \
    apt-get -y autoremove && apt-get clean && rm -rf /var/lib/apt/lists/* && \
    wget -q "https://pub-32cef6782a9e411e82222dee82af193e.r2.dev/Groot2-v${GROOT2_VERSION_ARG}-x86_64.AppImage" \
    -O /tmp/groot2.AppImage && \
    chmod +x /tmp/groot2.AppImage && \
    cd /tmp && ./groot2.AppImage --appimage-extract && \
    mv squashfs-root /opt/groot2 && \
    ln -s /opt/groot2/AppRun /usr/local/bin/groot2 && \
    rm -f /tmp/groot2.AppImage

WORKDIR ${DOCKER_ISAAC_COBOT_PATH}
