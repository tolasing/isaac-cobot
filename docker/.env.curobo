###
# cuRobo profile settings (extends .env.base)
###

# Pinned cuRobo commit installed in Dockerfile.curobo. Recorded here for
# visibility; the actual pin lives in the Dockerfile's pip install line.
CUROBO_COMMIT=ebb71702f3f70e767f40fd8e050674af0288abe8

# Pinned BehaviorTree.CPP tag installed in Dockerfile.curobo (bt_bridge/'s pybind11 bridge --
# see docs/behavior-tree-migration.md -- builds against this). Recorded here for visibility,
# same convention as CUROBO_COMMIT; the actual pin lives in the Dockerfile's git clone line.
BT_CPP_COMMIT=4.9.1

# Pinned Groot2 version installed in Dockerfile.curobo (desktop GUI to edit/monitor a
# BehaviorTree.CPP tree -- see docs/behavior-tree-migration.md). Confirmed reachable at
# https://pub-32cef6782a9e411e82222dee82af193e.r2.dev/Groot2-v<version>-x86_64.AppImage
GROOT2_VERSION=1.9.0
